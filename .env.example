# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Keep false in production until the staff-session function has passed clone testing.
VITE_USE_SERVER_SESSION=false

# Keep false until the secured HN lookup function has passed clone testing.
# When true, the browser must never fall back to reading hn_customers directly.
VITE_USE_SERVER_HN_LOOKUP=false

# วิธีหาค่า:
# 1. เข้าไปที่ Supabase Dashboard -> Project Settings -> API
# 2. คัดลอก Project URL และ anon public key
# 3. เปลี่ยนชื่อไฟล์ .env.example เป็น .env
# 4. ใส่ค่าจริงของคุณ
